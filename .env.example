# Operational Environment (development / production)
ENVIRONMENT=production
PORT=8000
LOG_LEVEL=info

# Frontend & CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Meteorological & Observational Providers
XKDR_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
NWP_TIMEOUT_SECONDS=10.0

# EmailJS Service Configuration (Server-Side OTP Delivery)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Security Controls & Abuse Protection
ENABLE_MODEL_RETRAINING=false
ADMIN_API_KEY=
RATE_LIMIT_PER_MINUTE=60
